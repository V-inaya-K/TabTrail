# TabTrail Backend Environment Variables
# Copy this to .env and adjust for your environment

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tabtrail

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Limits
MAX_BATCH_SIZE=100
MAX_SCREENSHOT_BASE64_BYTES=1048576